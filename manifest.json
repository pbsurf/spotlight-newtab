{
  "manifest_version": 3,
  "name": "spotlight-newtab",
  "version": "0.5.1",
  "description": "New tab page with a daily background image from Windows Spotlight, Bing, or your own image URLs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spotlight-newtab@styluslabs.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "topSites"
  ],
  "host_permissions": [
    "https://fd.api.iris.microsoft.com/*",
    "https://res.public.onecdn.static.microsoft/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
